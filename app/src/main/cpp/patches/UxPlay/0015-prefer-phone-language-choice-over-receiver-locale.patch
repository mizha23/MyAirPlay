+/* Does a sender-requested language identifier (MediaSelectionOptions-
+ * UnicodeLanguageIdentifier, e.g. "zh-Hans") match a playlist BCP 47
+ * tag (e.g. "zh-Hans-CN")? A prefix match in either direction counts
+ * (the shorter tag is a prefix of the longer one); otherwise the first
+ * two characters (the primary language subtag) must agree. */
+static bool
+language_code_matches(const char *playlist_code, const char *wanted) {
+    if (!playlist_code || !wanted || !*playlist_code || !*wanted) {
+        return false;
+    }
+    size_t wanted_len = strlen(wanted);
+    size_t playlist_len = strlen(playlist_code);
+    size_t n = wanted_len < playlist_len ? wanted_len : playlist_len;
+    if (strncmp(playlist_code, wanted, n) == 0) {
+        return true;
+    }
+    return strncmp(playlist_code, wanted, 2) == 0;
+}
